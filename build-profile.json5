{
  // 签名配置(signingConfigs)**不入库**:它是机器相关的材料(keystore/证书/profile + 加密口令),
  // 提交进来既泄漏又会导致别的机器构建失败(历史提交里就曾把另一台机器的 C:\Users\... 路径与
  // 口令提交上去)。
  //
  // 本机怎么加回来:DevEco(File → Project Structure → Signing Configs)会自动写入;
  // 命令行构建则把 signingConfigs 块补在本文件 `app` 下、并在 products[0] 里加回
  // "signingConfig": "default",材料放本机固定目录(例如 ~/.ohos/arkdo-signing/,需与 p12 同级的
  // material/ 目录一起保留,否则口令解不开)。没有这段配置也能构建,只是产出未签名 HAP。

  "app": {
      "products": [
      {
        "name": "default",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ],
    "capabilities": [
      {
        "bundleName": "com.kavin.linux.do",
        "config": [
          {
            "name": "Push Kit",
            "capability": "com.huawei.service.push.base_service"
          }
        ]
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
